# ---- Required ----
# Postgres connection string. On Vercel: the Supabase transaction pooler (port 6543).
# From your computer (migrations, seed, admin): the Supabase session pooler (port 5432). See SETUP.md.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres"
# Optional: the provider's CA certificate (Supabase: Project Settings -> Database -> SSL), with \n line breaks.
# When set, the database server's certificate is verified; connections are encrypted either way.
DATABASE_CA_CERT=""
# Optional: connections per server instance (default 5 on Vercel, 10 elsewhere)
DB_POOL_MAX=""
# Public URL of the site, no trailing slash
APP_URL="https://the7billiondollarbrain.com"

# ---- Payments (Stripe) ----
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---- Business calendar (Google Calendar) ----
# Create a Google Cloud service account, enable the Calendar API, share the business
# calendar with the service account's email ("Make changes to events"), then paste:
GOOGLE_CALENDAR_ID="your-business-calendar@gmail.com"
GOOGLE_SERVICE_ACCOUNT_EMAIL="booking@your-project.iam.gserviceaccount.com"
# Private key with literal \n line breaks
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Email notifications (Resend, optional) ----
RESEND_API_KEY=""
EMAIL_FROM="The 7 Billion Dollar Brain <info@the7billiondollarbrain.com>"
ADMIN_NOTIFY_EMAIL="info@the7billiondollarbrain.com"

# ---- Live chat (set ONE of these; optional) ----
NEXT_PUBLIC_CRISP_WEBSITE_ID=""
NEXT_PUBLIC_TAWK_PROPERTY_ID=""
NEXT_PUBLIC_TAWK_WIDGET_ID="default"

# ---- Contact details shown on the site ----
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_EMAIL="info@the7billiondollarbrain.com"

# ---- Feature flags ----
# Keep false until the investment offering has been reviewed by a securities attorney.
INVESTMENTS_ENABLED="false"
